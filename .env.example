# Скопируйте в .env и заполните. .env в git не попадает.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_SITE=
SECRET_KEY=
REFRESH_SECRET_KEY=
JWT-SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# дополнительные адреса сайта для CORS через запятую (localhost и 127.0.0.1 с любым портом разрешены всегда)
ALLOWED_ORIGINS=
EMAIL_API_KEY=
EMAIL_FROM=
