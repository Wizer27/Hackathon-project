# Caddy для «Парк Сказка».
# Сайт — статические файлы из /srv/skazka, бэкенд (FastAPI) — на 127.0.0.1:47813, доступен как /api/...
# Замените skazka.example.com на свой домен (A-запись должна указывать на сервер). HTTPS Caddy настроит сам.
# Сайт слушает нестандартный порт 48443, чтобы не занимать 443: адрес — https://skazka.example.com:48443
# (его же добавить в Google Cloud Console → Authorized JavaScript origins). Порт 48443 открыть в файрволе.
# Сертификат Let's Encrypt Caddy получает через порт 80 или 443 — хотя бы один из них должен вести на этот Caddy.
skazka.example.com:48443 {
	encode zstd gzip

	# бэкенд: /api/auth/google → http://127.0.0.1:47813/auth/google
	handle_path /api/* {
		reverse_proxy 127.0.0.1:47813
	}

	handle {
		root * /srv/skazka

		# исходники бэкенда, окружение и служебные файлы не раздаём
		@private {
			path /api/* /database/* /tools/* /deploy/* /venv/* /.venv/* /.git/* /.env* /requirements.txt *.py *.md
		}
		respond @private 404

		# тяжёлые ассеты (модели, текстуры, библиотеки) кешируются браузером
		@static path /assets/* /vendor/* /map/assets/*
		header @static Cache-Control "public, max-age=604800"
		header /map/sw.js Cache-Control "no-cache"
		# file_server ставит свой Content-Type — переопределяем после него (defer)
		@manifest path *.webmanifest
		header @manifest {
			Content-Type "application/manifest+json"
			defer
		}
		@glb path *.glb
		header @glb {
			Content-Type "model/gltf-binary"
			defer
		}
		@gltf path *.gltf
		header @gltf {
			Content-Type "model/gltf+json"
			defer
		}

		file_server
	}
}
